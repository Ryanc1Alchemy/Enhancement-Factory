# Required for all gates (Anthropic)
ANTHROPIC_API_KEY=

# Optional save/resume DB
DATABASE_URL=

# Optional /api/runs protection (set both to same value)
RUNS_API_SECRET=
VITE_RUNS_API_SECRET=

# Jira integration (Gate 6)
# Keep false during implementation to prevent real Jira writes.
JIRA_LIVE_ENABLED=false
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=GII
JIRA_STORY_POINTS_FIELD=customfield_10016

# Phase 1 fixed Enhancement Factory context
JIRA_CONTEXT_ISSUE_KEY=GII-34
JIRA_ALLOWED_ISSUE_TYPES=Story,Epic
JIRA_LINK_TYPE=Relates
# Optional assign-on-create for filtered board visibility
JIRA_ASSIGNEE_ACCOUNT_ID=
